# --- Documents / indexing ---
DOCS_PATH=./documents
PERSIST_DIR=./db
COLLECTION_NAME=documents

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
DEFAULT_TOP_K=3

# --- LLM (via LiteLLM / Ollama) ---
LLM_MODEL=ollama/phi3
OLLAMA_API_BASE=http://localhost:11434
LLM_TIMEOUT_SECONDS=60

# --- API ---
CORS_ORIGINS=[http://localhost:5173]
LOG_LEVEL=INFO
